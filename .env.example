# fleet-v2 coordinator settings. Copy to .env on box1 and fill in. .env is never
# committed (see .gitignore) and is read only by the coordinator container.

# Dashboard address on your tailnet (tailscale serve in front of port 8090).
FLEET_PUBLIC_URL=https://box1.<your-tailnet>.ts.net
# Your Tailscale login (email). Only this login may open the dashboard.
FLEET_OWNER_LOGIN=you@example.com

# Alpaca PAPER keys (Alpaca dashboard > Paper account > API Keys).
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Real money stays impossible unless this is true AND you confirm on the dashboard.
ALPACA_LIVE=false
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# Stock prices: iex (free, default) or sip (paid; ask before switching).
ALPACA_DATA_FEED=iex

# Futures prices (MES, MNQ) from Databento, pay-as-you-go. Leave empty to use the free
# SPY/QQQ stand-in ("proxy" prices). Every download asks Databento for its cost first and
# is refused above max_download_usd in config/topstep.toml.
DATABENTO_API_KEY=

# TopstepX (ProjectX API), for futures models that are ready for a Combine. Make the API
# key in TopstepX under Settings > API (a separate paid subscription). Nothing trades on
# Topstep until you also type TRADE ON TOPSTEP in the dashboard and restart.
TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=
# The name (or id) of the TopstepX account to trade, e.g. your Combine account.
TOPSTEPX_ACCOUNT=

# Database password used by docker-compose (any long random string).
POSTGRES_PASSWORD=change-me
